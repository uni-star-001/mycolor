{
  "manifest_version": 3,
  "name": "MyColor",
  "version": "0.1.0",
  "description": "色覚特性のある方のWeb閲覧を快適にするChrome拡張機能",
    "default_locale": "ja",
    "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MyColor"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/axe.min.js", "lib/chroma.min.js", "utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}

